# Usado automaticamente pelo Docker Compose. Não versionar o arquivo .env.
# Somente credenciais locais de exemplo: substitua antes de executar.
POSTGRES_DB=linklab
POSTGRES_USER=linklab
POSTGRES_PASSWORD=substitua-por-uma-senha-local
DJANGO_SECRET_KEY=substitua-por-uma-chave-aleatoria
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,[::1]
SHORT_URL_BASE=http://localhost:8000
